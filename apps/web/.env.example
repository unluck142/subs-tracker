# Куда проксировать /api/* (адрес NestJS API). Учитывается при `npm run build`
API_URL=http://localhost:4000

# Username бота без @ — для кнопки «Открыть в Telegram» на главной странице
NEXT_PUBLIC_BOT_USERNAME=nespishut_bot

# Для страницы /privacy (152-ФЗ): кто оператор персональных данных и куда писать.
# NEXT_PUBLIC_OPERATOR_NAME=ИП Иванов Иван Иванович, ИНН 000000000000
# NEXT_PUBLIC_SUPPORT_CONTACT=@username

# Адрес сайта для sitemap.xml и ссылок в SEO-страницах
# NEXT_PUBLIC_SITE_URL=https://nespishut.ru
