# Подключение к PostgreSQL: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/БАЗА
DATABASE_URL=postgresql://postgres:ВАШ_ПАРОЛЬ@localhost:5432/subs

# Порт API (Next.js проксирует на него запросы /api/*)
PORT=4000

# Токен бота от @BotFather. Пустой — API работает, но бот и напоминания выключены
BOT_TOKEN=

# Публичный HTTPS-адрес мини-приложения, например https://subs.example.ru/app
# Telegram открывает мини-приложения только по HTTPS
WEBAPP_URL=

# Только для локальной разработки: открываешь http://localhost:3000/app в браузере
# и API считает тебя пользователем с этим Telegram ID. В production (NODE_ENV=production) игнорируется.
DEV_TELEGRAM_ID=111111

# Сколько секунд действительна авторизация из мини-приложения (по умолчанию сутки)
# INIT_DATA_MAX_AGE=86400
